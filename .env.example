# Avalok Server Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# PostgreSQL connection string (required)
AVALOK_DATABASE_URL=postgres://avalok:avalok@localhost:5432/avalok?sslmode=disable

# JWT signing secret — must be at least 32 characters (required)
AVALOK_JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters-long

# Network bind address (default: 0.0.0.0)
AVALOK_BIND_ADDR=0.0.0.0

# HTTP server port (default: 9090)
AVALOK_PORT=9090
